# /etc/sudoers.d/user_local

Defaults  env_reset
Defaults  secure_path = /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/<user>/.local/bin
Defaults  timestamp_timeout=60
Defaults  umask=0027
Defaults  umask_override
Defaults  use_pty

root ALL=(ALL) ALL
%wheel ALL=(ALL) ALL

Cmnd_Alias DNF = /usr/bin/dnf, /usr/bin/rpm
Cmnd_Alias REBOOT = /sbin/reboot
Cmnd_Alias SHUTDOWN = /sbin/poweroff

<user> ALL=(root) NOPASSWD: DNF
<user> ALL=(root) NOPASSWD: REBOOT, SHUTDOWN
